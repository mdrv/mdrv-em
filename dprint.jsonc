{
	"$schema": "https://dprint.dev/schemas/v0.json",
	"useTabs": true,
	"markdown": {},
	"toml": {},
	"json": {
		"trailingCommas": "maintain"
	},
	"excludes": ["**/node_modules", "**/*-lock.json", "**/dist", "**/target"],
	"plugins": [
		"https://plugins.dprint.dev/toml-0.8.0.wasm",
		"https://plugins.dprint.dev/markdown-0.23.2.wasm",
		"https://plugins.dprint.dev/json-0.23.0.wasm"
	]
}
